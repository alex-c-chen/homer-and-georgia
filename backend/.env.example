# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=
ANTHROPIC_API_KEY=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Static bearer token guarding /schedule, /chat, /usage.
# Leave blank to disable auth in local dev.
API_SECRET=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
TOPICS_PER_DAY=7
